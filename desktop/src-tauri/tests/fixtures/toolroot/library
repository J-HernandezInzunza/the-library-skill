#!/bin/sh
# Fake `library` wrapper: replays recorded CLI payloads so the desktop app's CLI
# layer can be tested without a bootstrapped clone, a catalog, or the network.
# Each subcommand below stands for one thing the real CLI can do to a caller.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
sub=$1
shift

case "$sub" in
  list)
    cat "$here/payloads/list.json"
    ;;
  doctor)
    # Healthy: report on stdout, exit 0.
    cat "$here/payloads/doctor.json"
    ;;
  sick)
    # `doctor` signals findings by exiting 1 while still printing the whole report.
    cat "$here/payloads/doctor-problems.json"
    exit 1
    ;;
  show)
    # $1 is the entry name; each payload is a real recorded one, kept apart because
    # no single entry has both a two-catalog override chain and a dependency tree.
    case "$1" in
      triage-bug) cat "$here/payloads/show-deps.json" ;;
      broken)     cat "$here/payloads/show-broken.json" ;;
      *)          cat "$here/payloads/show.json" ;;
    esac
    ;;
  use)
    # The two branches return disjoint shapes — `would_install` vs `installed` — so a
    # preview that lost its --dry-run fails to deserialize rather than silently
    # reporting a plan for an install that already happened.
    name=$1
    case " $* " in
      *" --dry-run "*)
        case " $* " in
          # A project install resolves against LIBRARY_CWD, so the dest is echoed from
          # it: a preview anchored at the wrong directory shows up as the wrong path
          # rather than as a passing test.
          *" --project "*)
            printf '{"status":"OK","dry_run":true,"scope":"project","overrides":[],'
            printf '"overridden_by":null,"would_install":[{"type":"skill","name":"%s",' "$name"
            printf '"catalog":"personal","dest":"%s/.claude/skills/%s",' "${LIBRARY_CWD:-UNSET}" "$name"
            printf '"state":"not_installed"}]}\n'
            ;;
          *)
            case "$name" in
              grilling) cat "$here/payloads/use-dry-run-drifted.json" ;;
              *)        cat "$here/payloads/use-dry-run.json" ;;
            esac
            ;;
        esac
        ;;
      *)
        case "$name" in
          # Installed, but the type's main file is not where it should be: the CLI
          # prints the whole report and *then* exits 1.
          grilling) cat "$here/payloads/use-unverified.json"; exit 1 ;;
          # A real failure, which also exits 1 with a parseable body.
          broken)   cat "$here/payloads/use-error.json"; exit 1 ;;
          *)        cat "$here/payloads/use.json" ;;
        esac
        ;;
    esac
    ;;
  uninstall)
    name=$1
    case "$name" in
      # A hand-made directory: no receipt, so the tool will not claim it put it there.
      # Exit 2 with the whole report still printed.
      handmade)
        case " $* " in
          *" --force "*)
            echo '{"status":"OK","type":"skill","name":"handmade","deleted":["/Users/dev/.claude/skills/handmade"],"refused":[]}'
            ;;
          *)
            echo '{"status":"REFUSED","type":"skill","name":"handmade","deleted":[],"refused":["/Users/dev/.claude/skills/handmade"]}'
            exit 2
            ;;
        esac
        ;;
      # Installed in two scopes, one of them by hand: partly done, partly refused.
      mixed)
        echo '{"status":"REFUSED","type":"skill","name":"mixed","deleted":["/Users/dev/.claude/skills/mixed"],"refused":["/proj/.claude/skills/mixed"]}'
        exit 2
        ;;
      *)
        echo '{"status":"OK","type":"skill","name":"grilling","deleted":["/Users/dev/.claude/skills/grilling"],"refused":[]}'
        ;;
    esac
    ;;
  sync)
    # Without --force sync skips items whose source and local copy both match the
    # receipt, so "nothing happened" is the healthy result. With it, everything is
    # re-fetched and one item fails — exit 1 with the whole report still printed.
    case " $* " in
      *" --force "*) cat "$here/payloads/sync.json"; exit 1 ;;
      *)             cat "$here/payloads/sync-clean.json" ;;
    esac
    ;;
  suggest-source)
    # Echoes the path back, so a call that lost or mangled its argument fails rather than
    # matching a canned payload. Two answers, both exit 0: a derivable URL, and the miss
    # that is an answer rather than a failure.
    case "$1" in
      *"/no-repo/"*)
        printf '{"status":"NONE","path":"%s","suggestion":null,' "$1"
        printf '"reason":"not inside a git repository"}\n'
        ;;
      *)
        printf '{"status":"OK","path":"%s",' "$1"
        printf '"suggestion":"https://github.com/acme/tools/blob/main/skills/deploy/SKILL.md",'
        printf '"reason":null}\n'
        ;;
    esac
    ;;
  add)
    # A real recorded payload from a `local`-mode catalog. The argv this was called with
    # is asserted from the command log rather than echoed here: every flag `add` takes
    # is already visible there, and a wrong one has to fail the argv test, not the parse.
    cat "$here/payloads/add.json"
    ;;
  update)
    # Two shapes, and the difference is load-bearing: a no-op short-circuits before the
    # catalog is touched, so the write keys are absent entirely rather than empty.
    case "$1" in
      unchanged) cat "$here/payloads/update-unchanged.json" ;;
      *)         cat "$here/payloads/update.json" ;;
    esac
    ;;
  remove)
    # The dry run and the real removal return disjoint shapes — `diff` vs `deleted` — so
    # a confirmation that lost its --dry-run fails to parse rather than silently
    # reporting a completed removal as a plan.
    case " $* " in
      *" --dry-run "*) cat "$here/payloads/remove-dry-run.json" ;;
      *" --purge "*)   cat "$here/payloads/remove-purged.json" ;;
      *)               cat "$here/payloads/remove.json" ;;
    esac
    ;;
  push)
    # `push` reports four different things depending on the entry's source, and the app
    # renders each differently, so all four have a case here.
    name=$1
    # The scope is echoed back into the payload: pushing from the wrong local copy is the
    # risk this command carries, so a mis-built argv has to fail rather than quietly match
    # a canned payload. Same reasoning as `use --project` echoing LIBRARY_CWD.
    scope=UNSET
    prev=
    for a in "$@"; do
      [ "$prev" = "--from" ] && scope=$a
      prev=$a
    done

    case " $* " in
      *" --dry-run "*)
        case "$name" in
          # A remote source, and a name two catalogs define, so the provenance note fires.
          shared-skill)
            printf '{"status":"DRY_RUN","would_change":true,"name":"%s","catalog":"personal",' "$name"
            printf '"branch":"library/update-%s-20250101T1200",' "$name"
            printf '"diff":"commit abc123\\n--- a/SKILL.md\\n+++ b/SKILL.md\\n+edited locally\\n",'
            printf '"note":"'"'"'%s'"'"' is defined in more than one catalog and nothing on disk records which copy was installed. Pushing to '"'"'personal'"'"'."}\n' "$name"
            ;;
          # The healthy common case: the local copy already matches its source.
          unchanged)
            printf '{"status":"DRY_RUN","would_change":false,"name":"%s","catalog":"personal",' "$name"
            printf '"dest":"/Users/tester/sources/%s","note":null}\n' "$name"
            ;;
          # A local-path source. The dest carries both the scope and LIBRARY_CWD, so a lost
          # --from or a mis-anchored project push reads as the wrong path.
          *)
            printf '{"status":"DRY_RUN","would_change":true,"name":"%s","catalog":"personal",' "$name"
            printf '"dest":"%s/sources/%s/from-%s","note":null}\n' "${LIBRARY_CWD:-UNSET}" "$name" "$scope"
            ;;
        esac
        ;;
      *)
        case "$name" in
          # gh could not open the PR, so only the branch was pushed. "Branch pushed" is
          # not "PR opened", and the app must not report it as one.
          shared-skill)
            printf '{"status":"OK","name":"%s","catalog":"personal","changed":true,' "$name"
            printf '"note":null,"method":"manual","branch":"library/update-%s-20250101T1200",' "$name"
            printf '"compare_url":"https://github.com/acme/skills/compare/main...library/update-%s-20250101T1200?expand=1"}\n' "$name"
            ;;
          # gh opened it.
          gh-skill)
            printf '{"status":"OK","name":"%s","catalog":"personal","changed":true,"note":null,' "$name"
            printf '"method":"gh","branch":"library/update-%s-20250101T1200",' "$name"
            printf '"pr_url":"https://github.com/acme/skills/pull/42"}\n' "$name"
            ;;
          # A failure the CLI reports as a parseable body on stdout while exiting 1, so
          # reading stderr alone would surface an empty error.
          broken)
            printf '{"status":"ERROR","name":"%s","catalog":"personal",' "$name"
            printf '"reason":"push rejected — you lack write access to acme/skills.","note":null}\n' "$name"
            exit 1
            ;;
          *)
            printf '{"status":"OK","name":"%s","catalog":"personal","changed":true,' "$name"
            printf '"note":null,"pushed":false,"dest":"/Users/tester/sources/%s"}\n' "$name"
            ;;
        esac
        ;;
    esac
    ;;
  catalog)
    # `catalog list`, `catalog add`, `catalog init`, `catalog remove` — the action arrives
    # as "$1" after the shift.
    action=$1
    shift
    case "$action" in
      list)
        cat "$here/payloads/catalogs.json"
        ;;
      add|init)
        # The argv is echoed into the payload's `location`, because --position is the flag
        # whose two values silently decide which copy of a name installs. A form that sent
        # the wrong one would otherwise pass every test.
        id=UNSET
        position=UNSET
        prev=
        for a in "$@"; do
          [ "$prev" = "--id" ] && id=$a
          [ "$prev" = "--position" ] && position=$a
          prev=$a
        done
        # `catalog init` scaffolds, so it reports what it created; `add` does not.
        created=null
        [ "$action" = "init" ] && created='"/Users/tester/new/library.yaml"'
        printf '{"status":"OK","id":"%s","kind":"local","precedence":1,"registered":2,' "$id"
        printf '"write_mode":"local","writable":true,"entries":0,'
        printf '"location":"/Users/tester/new/library.yaml?position=%s","created":%s,' "$position" "$created"
        printf '"migrated":[]}\n'
        ;;
      remove)
        # Unregistering the only catalog is refused: the tool needs one to read from.
        case "$1" in
          personal)
            echo "error: 'personal' is the only registered catalog" >&2
            exit 1
            ;;
          purged)
            # A purge names what it deleted, and separately the receipts it cleared for
            # destinations that were already gone.
            printf '{"status":"OK","id":"%s","purged_clone":null,"clone_kept_at":null,' "$1"
            printf '"purged_installs":["/Users/tester/.claude/skills/alpha"],'
            printf '"cleared_receipts":["/Users/tester/.claude/skills/already-gone"],'
            printf '"migrated":[]}\n'
            ;;
          *)
            printf '{"status":"OK","id":"%s","purged_clone":null,' "$1"
            printf '"clone_kept_at":null,"purged_installs":[],"cleared_receipts":[],'
            printf '"migrated":[]}\n'
            ;;
        esac
        ;;
      *)
        echo "fixture has no catalog action: $action" >&2
        exit 1
        ;;
    esac
    ;;
  probe)
    # Proves the layer's own contract reached the child: `--json` appended by
    # run_json, and LIBRARY_CWD anchored rather than inherited from the GUI's $PWD.
    printf '{"argv":['
    sep=''
    for a in "$@"; do
      printf '%s"%s"' "$sep" "$a"
      sep=','
    done
    printf '],"library_cwd":"%s"}\n' "${LIBRARY_CWD:-UNSET}"
    ;;
  ambiguous)
    cat "$here/payloads/ambiguous.json"
    exit 2
    ;;
  refused)
    # The other exit 2: a refusal, not a choice. Must not read as ambiguity.
    echo '{"status": "REFUSED", "dest": "/tmp/hand-made"}'
    echo 'no install receipt for /tmp/hand-made' >&2
    exit 2
    ;;
  unbootstrapped)
    # What library.py does when PyYAML is missing: plain text, no JSON, exit 3.
    echo 'PyYAML not found: this clone is not bootstrapped. Run `python3 bootstrap.py`.' >&2
    exit 3
    ;;
  boom)
    echo 'no such entry: nope' >&2
    exit 1
    ;;
  garbage)
    echo 'Usage: library [-h] ...'
    ;;
  *)
    echo "fixture has no case for: $sub" >&2
    exit 1
    ;;
esac

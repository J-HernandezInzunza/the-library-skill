#!/bin/sh
# Fake `library` wrapper: replays recorded CLI payloads so the desktop app's CLI
# layer can be tested without a bootstrapped clone, a catalog, or the network.
# Each subcommand below stands for one thing the real CLI can do to a caller.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
sub=$1
shift

case "$sub" in
  list)
    cat "$here/payloads/list.json"
    ;;
  doctor)
    # Healthy: report on stdout, exit 0.
    cat "$here/payloads/doctor.json"
    ;;
  sick)
    # `doctor` signals findings by exiting 1 while still printing the whole report.
    cat "$here/payloads/doctor-problems.json"
    exit 1
    ;;
  show)
    # $1 is the entry name; each payload is a real recorded one, kept apart because
    # no single entry has both a two-catalog override chain and a dependency tree.
    case "$1" in
      triage-bug) cat "$here/payloads/show-deps.json" ;;
      broken)     cat "$here/payloads/show-broken.json" ;;
      *)          cat "$here/payloads/show.json" ;;
    esac
    ;;
  use)
    # A preview must never be able to install: this fixture refuses any `use` that
    # is not a dry run, so a lost --dry-run fails the suite instead of the machine.
    name=$1
    case " $* " in
      *" --dry-run "*) ;;
      *) echo 'fixture refuses a use that is not a dry run' >&2; exit 1 ;;
    esac
    case "$name" in
      grilling) cat "$here/payloads/use-dry-run-drifted.json" ;;
      *)        cat "$here/payloads/use-dry-run.json" ;;
    esac
    ;;
  catalog)
    # `catalog list` — the subcommand arrives as "$1" after the shift.
    cat "$here/payloads/catalogs.json"
    ;;
  probe)
    # Proves the layer's own contract reached the child: `--json` appended by
    # run_json, and LIBRARY_CWD anchored rather than inherited from the GUI's $PWD.
    printf '{"argv":['
    sep=''
    for a in "$@"; do
      printf '%s"%s"' "$sep" "$a"
      sep=','
    done
    printf '],"library_cwd":"%s"}\n' "${LIBRARY_CWD:-UNSET}"
    ;;
  ambiguous)
    cat "$here/payloads/ambiguous.json"
    exit 2
    ;;
  refused)
    # The other exit 2: a refusal, not a choice. Must not read as ambiguity.
    echo '{"status": "REFUSED", "dest": "/tmp/hand-made"}'
    echo 'no install receipt for /tmp/hand-made' >&2
    exit 2
    ;;
  unbootstrapped)
    # What library.py does when PyYAML is missing: plain text, no JSON, exit 3.
    echo 'PyYAML not found: this clone is not bootstrapped. Run `python3 bootstrap.py`.' >&2
    exit 3
    ;;
  boom)
    echo 'no such entry: nope' >&2
    exit 1
    ;;
  garbage)
    echo 'Usage: library [-h] ...'
    ;;
  *)
    echo "fixture has no case for: $sub" >&2
    exit 1
    ;;
esac

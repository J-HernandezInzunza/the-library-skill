{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Library",
  "version": "1.0.0",
  "identifier": "com.josehernandezinzunza.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "The Library",
        "width": 900,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "A native GUI over The Library CLI.",
    "longDescription": "Browse, install, and sync the skills, agents, and prompts in your private Library catalog, and run guided setup walkthroughs for the ones that need a credential.",
    "copyright": "Copyright © 2026 Jose Hernandez Inzunza",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}

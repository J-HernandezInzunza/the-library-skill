.DS_Store
.env
*.tmp

# library CLI
.venv/
__pycache__/
*.pyc

# per-device config, install receipts, and local catalog clones (never committed)
config.local.yaml
config.local.yaml.lock
.installs.json
.installs.json.lock

# ...except the desktop app's test fixtures, which need a stand-in config on every
# machine: without one, the suite reads every failing fixture command as "tool not
# configured" and passes only where a developer happens to have a real config.
!desktop/src-tauri/tests/fixtures/**/config.local.yaml
.catalog-repo/
.catalogs/


# in-flight planning docs: requirements, design, task plan, and the build ledger.
# Kept on disk, out of the repo — they describe how a change was built, not how the
# tool works. Anything durable belongs in docs/ instead.
specs/
